# Meat Products of India — Environment Configuration Example
# Copy this file to .env or export variables in your environment

# Flask Secret Key (REQUIRED for production deployment)
APP_SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production

# Custom SQLite Database File Path (Optional)
DB_PATH=data/meatshop.db

# Shared with the cloud license server for authenticated, encrypted backups
CLOUD_BACKUP_TOKEN=change_this_to_a_random_secret_of_at_least_32_characters
CLOUD_BACKUP_ENCRYPTION_KEY=generate_a_fernet_key_and_store_it_securely

# Shared with the cloud license server for outlet API authentication
CLOUD_LICENSE_API_TOKEN=change_this_to_a_random_secret_of_at_least_32_characters
